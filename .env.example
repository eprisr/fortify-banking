#NEXT
NEXT_PUBLIC_SITE_URL=http://localhost:3000

#APPWRITE
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_USER_COLLECTION_ID=
APPWRITE_BANK_COLLECTION_ID=
APPWRITE_TRANSACTION_COLLECTION_ID=
APPWRITE_NOTIFICATION_COLLECTION_ID=
APPWRITE_KEY=

#LEDGER (Neon Postgres, ADR-016)
# Set in Vercel by Neon's integration. Pooled URL for the app, direct URL
# for migrations (npm run db:migrate).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

#PLAID
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Use 'sandbox' for testing, 'production' once you have live credentials

#DWOLLA
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_ENV=sandbox

#ENCRYPTION
# 32-byte key, base64-encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ACCOUNT_ID_ENCRYPTION_KEY=