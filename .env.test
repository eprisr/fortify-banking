### Loaded automatically by next/jest (via @next/env) whenever NODE_ENV=test.
### These are dummy values so SDK clients (Plaid, Dwolla) can be constructed
### at module-import time without throwing. No real credentials belong here —
### every outbound call these SDKs make during tests is intercepted by MSW
### (see __tests__/msw/) and never reaches a real network.

#PLAID
PLAID_CLIENT_ID=test-plaid-client-id
PLAID_SECRET=test-plaid-secret
PLAID_ENV=sandbox

#DWOLLA
DWOLLA_KEY=test-dwolla-key
DWOLLA_SECRET=test-dwolla-secret
DWOLLA_ENV=sandbox

#NEXT
NEXT_PUBLIC_SITE_URL=http://localhost:3000
